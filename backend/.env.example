# Kopieren nach .env und anpassen. Nie committen!

# Schützt /api/admin/* (Mailadressen, Verlosungs-Pool). Ohne diesen Wert
# bleiben die Admin-Endpunkte komplett unerreichbar (404).
# Erzeugen z.B. mit: openssl rand -hex 24
ADMIN_PASSWORD=

# Erlaubte Origins fürs öffentliche Frontend (index.html auf GitHub Pages).
# /live und /admin brauchen das nicht, die werden vom Backend selbst ausgeliefert.
CORS_ORIGINS=http://localhost:5500,https://openzirndorf.github.io
